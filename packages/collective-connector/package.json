{
  "name": "@clowder-ai/collective-connector",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Collective backend business and Host-loadable module",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./plugin.yaml"
  },
  "files": [
    "dist",
    "plugin.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test:lifecycle": "node --import tsx --test test/module-lifecycle.test.ts",
    "test:business": "vitest run src/business",
    "test:installed": "node --test test/installed-directory.test.mjs",
    "test:source": "node --test test/source-continuity.test.mjs",
    "test": "pnpm test:lifecycle && pnpm test:business",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clowder-ai/plugin-sdk": "0.2.0-beta.19",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "4.0.18",
    "yaml": "2.9.0"
  }
}
